<?xml version="1.0" encoding="UTF-8" ?>
<Resources xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:converters="clr-namespace:InventoryScannerMAUI.Converters">

    <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    <converters:IsEmptyConverter x:Key="IsEmptyConverter" />

    <!-- Default Styles -->
    <Style TargetType="Button">
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="#F2F2F7" />
        <Setter Property="Padding" Value="15,10" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="HeightRequest" Value="50" />
    </Style>

</Resources>

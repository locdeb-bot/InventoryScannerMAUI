<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui"
             xmlns:viewmodels="clr-namespace:InventoryScannerMAUI.ViewModels"
             x:Class="InventoryScannerMAUI.Views.ScannerPage"
             Title="Scanner">

    <ContentPage.BindingContext>
        <viewmodels:ScannerViewModel />
    </ContentPage.BindingContext>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource DarkBackground}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="20,10" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource CardBackgroundDark}}">
            <Label Text="Barcode Scanner" FontSize="24" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
            <Label Text="{Binding StatusMessage}" FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource SecondaryTextColorDark}}" />
        </StackLayout>

        <!-- Scanner View -->
        <Border Grid.Row="1" Margin="20" CornerRadius="12" BackgroundColor="#1C1C1E" Padding="0">
            <zxing:CameraBarcodeReaderView
                x:Name="CameraView"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand" />
        </Border>

        <!-- Scanned Barcode Display -->
        <Border Grid.Row="1" Margin="20,20,20,100" CornerRadius="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource CardBackgroundDark}}"
                Padding="15" IsVisible="{Binding ShowItemDetails, Converter={StaticResource InverseBoolConverter}}">
            <StackLayout>
                <Label Text="Last Scanned:" FontSize="12" Opacity="0.7" />
                <Label Text="{Binding ScannedBarcode}" FontSize="20" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryColorDark}}" />
            </StackLayout>
        </Border>

        <!-- Item Details Card -->
        <Border Grid.Row="2" Margin="20" CornerRadius="16"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource CardBackgroundDark}}"
                Padding="20" IsVisible="{Binding ShowItemDetails}" HeightRequest="280">
            <ScrollView>
                <StackLayout>
                    <Label Text="{Binding FoundItem.Name}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding FoundItem.SKU}" FontSize="14" Opacity="0.7" />

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,15" />

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                        <StackLayout Grid.Column="0">
                            <Label Text="Quantity" FontSize="12" Opacity="0.7" />
                            <Label Text="{Binding FoundItem.Quantity}" FontSize="28" FontAttributes="Bold" TextColor="#34C759" />
                        </StackLayout>
                        <StackLayout Grid.Column="1">
                            <Label Text="Location" FontSize="12" Opacity="0.7" />
                            <Label Text="{Binding FoundItem.Location}" FontSize="16" />
                        </StackLayout>
                        <StackLayout Grid.Column="2">
                            <Label Text="Barcode" FontSize="12" Opacity="0.7" />
                            <Label Text="{Binding FoundItem.Barcode}" FontSize="14" FontFamily="monospace" />
                        </StackLayout>
                    </Grid>

                    <StackLayout Orientation="Horizontal" Margin="0,15,0,0" HorizontalOptions="Center">
                        <Button Text="-" WidthRequest="60" HeightRequest="60" CornerRadius="30"
                                BackgroundColor="#FF3B30" TextColor="White" FontSize="24"
                                Command="{Binding DecrementQuantityCommand}" />
                        <Button Text="+" WidthRequest="60" HeightRequest="60" CornerRadius="30"
                                BackgroundColor="#34C759" TextColor="White" FontSize="24" Margin="20,0"
                                Command="{Binding IncrementQuantityCommand}" />
                    </StackLayout>
                </StackLayout>
            </ScrollView>
        </Border>

        <!-- New Item Form -->
        <Border Grid.Row="2" Margin="20" CornerRadius="16"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource CardBackgroundDark}}"
                Padding="20" IsVisible="{Binding ShowNewItemForm}" HeightRequest="320">
            <ScrollView>
                <StackLayout>
                    <Label Text="New Item" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding ScannedBarcode}" FontSize="14" Opacity="0.7" />

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,15" />

                    <Entry Placeholder="Item Name" Text="{Binding FoundItem.Name, Mode=TwoWay}" Margin="0,5" />
                    <Entry Placeholder="SKU" Text="{Binding FoundItem.SKU, Mode=TwoWay}" Margin="0,5" />
                    <Entry Placeholder="Location" Text="{Binding FoundItem.Location, Mode=TwoWay}" Margin="0,5" />
                    <Entry Placeholder="Quantity" Keyboard="Numeric" Text="{Binding FoundItem.Quantity, Mode=TwoWay}" Margin="0,5" />
                    <Entry Placeholder="Description" Text="{Binding FoundItem.Description, Mode=TwoWay}" Margin="0,5" />

                    <StackLayout Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Text="Cancel" BackgroundColor="#8E8E93" TextColor="White" CornerRadius="10"
                                Command="{Binding ClearFormCommand}" HorizontalOptions="FillAndExpand" />
                        <Button Text="Save" BackgroundColor="#007AFF" TextColor="White" CornerRadius="10"
                                Command="{Binding SaveItemCommand}" HorizontalOptions="FillAndExpand" Margin="10,0,0,0" />
                    </StackLayout>
                </StackLayout>
            </ScrollView>
        </Border>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Color="#007AFF" />
    </Grid>
</ContentPage>

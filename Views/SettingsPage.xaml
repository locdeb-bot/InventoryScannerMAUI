<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:InventoryScannerMAUI.ViewModels"
             x:Class="InventoryScannerMAUI.Views.SettingsPage"
             Title="Settings">

    <ContentPage.BindingContext>
        <viewmodels:SettingsViewModel />
    </ContentPage.BindingContext>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource DarkBackground}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="20,15" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource CardBackgroundDark}}">
            <Label Text="Settings" FontSize="24" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
        </StackLayout>

        <!-- Settings Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <StackLayout Spacing="25">

                <!-- Database Settings Section -->
                <StackLayout>
                    <Label Text="Database Configuration" FontSize="18" FontAttributes="Bold" Margin="0,0,0,10"
                           TextColor="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />

                    <Border CornerRadius="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource CardBackgroundDark}}" Padding="15">
                        <StackLayout Spacing="15">
                            <StackLayout Orientation="Horizontal">
                                <Switch x:Name="UseSqlServerSwitch" IsToggled="{Binding UseSqlServer}" />
                                <Label Text="Use SQL Server (instead of local SQLite)" VerticalOptions="Center" />
                            </StackLayout>

                            <StackLayout IsVisible="{Binding UseSqlServer}">
                                <Label Text="SQL Server Connection String" FontSize="14" Opacity="0.7" />
                                <Entry Placeholder="Server=...;Database=...;User Id=...;Password=..."
                                       Text="{Binding SqlServerConnectionString, Mode=TwoWay}"
                                       IsPassword="True" />
                                <Button Text="Scan Connection String (QR Code)" BackgroundColor="#FF9500" TextColor="White"
                                        CornerRadius="8" Command="{Binding ScanConnectionStringCommand}" />
                                <Button Text="Test Connection" BackgroundColor="#34C759" TextColor="White"
                                        CornerRadius="8" Command="{Binding TestConnectionCommand}" Margin="0,10,0,0" />
                            </StackLayout>
                        </StackLayout>
                    </Border>
                </StackLayout>

                <!-- Sync Section -->
                <StackLayout>
                    <Label Text="Data Synchronization" FontSize="18" FontAttributes="Bold" Margin="0,0,0,10"
                           TextColor="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />

                    <Border CornerRadius="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource CardBackgroundDark}}" Padding="15">
                        <StackLayout Spacing="15">
                            <StackLayout>
                                <Label Text="Sync Status" FontSize="14" Opacity="0.7" />
                                <Label Text="{Binding SyncStatus}" FontSize="16" FontAttributes="Bold" />
                            </StackLayout>

                            <Button Text="Sync to Server" BackgroundColor="#007AFF" TextColor="White"
                                    CornerRadius="8" Command="{Binding SyncToServerCommand}"
                                    IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}" />

                            <ActivityIndicator IsRunning="{Binding IsSyncing}" Color="#007AFF" />
                        </StackLayout>
                    </Border>
                </StackLayout>

                <!-- About Section -->
                <StackLayout>
                    <Label Text="About" FontSize="18" FontAttributes="Bold" Margin="0,0,0,10"
                           TextColor="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />

                    <Border CornerRadius="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource CardBackgroundDark}}" Padding="15">
                        <StackLayout Spacing="10">
                            <StackLayout Orientation="Horizontal">
                                <Label Text="App Version:" Opacity="0.7" />
                                <Label Text="{Binding AppVersion}" FontAttributes="Bold" />
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <Label Text="Platform:" Opacity="0.7" />
                                <Label Text="iOS (MAUI)" FontAttributes="Bold" />
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <Label Text="Database:" Opacity="0.7" />
                                <Label Text="SQLite (Local) + SQL Server" FontAttributes="Bold" />
                            </StackLayout>
                        </StackLayout>
                    </Border>
                </StackLayout>

                <!-- Save Button -->
                <Button Text="Save Settings" BackgroundColor="#007AFF" TextColor="White"
                        CornerRadius="10" Command="{Binding SaveSettingsCommand}" Margin="0,10" />

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

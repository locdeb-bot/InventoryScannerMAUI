<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:InventoryScannerMAUI.ViewModels"
             x:Class="InventoryScannerMAUI.Views.InventoryPage"
             Title="Inventory">

    <ContentPage.BindingContext>
        <viewmodels:InventoryViewModel />
    </ContentPage.BindingContext>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource DarkBackground}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Search -->
        <StackLayout Grid.Row="0" Padding="20,15" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource CardBackgroundDark}}">
            <Label Text="Inventory" FontSize="24" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />

            <SearchBar Placeholder="Search items..."
                       Text="{Binding SearchText, Mode=TwoWay}"
                       Margin="0,10,0,0"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}" />
        </StackLayout>

        <!-- Items List -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" RefreshCommand="{Binding RefreshCommandCommand}">
            <CollectionView ItemsSource="{Binding Items}" Margin="15,10"
                            SelectionMode="Single" SelectionChanged="OnItemSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5" CornerRadius="12" Padding="15"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource CardBackgroundDark}}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <StackLayout Grid.Column="0" Grid.Row="0">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
                                    <Label Text="{Binding SKU}" FontSize="12" Opacity="0.7"
                                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource SecondaryTextColorDark}}" />
                                </StackLayout>

                                <Label Grid.Column="0" Grid.Row="1" Text="{Binding Barcode}" FontSize="12"
                                       FontFamily="monospace" Opacity="0.6" Margin="0,5,0,0" />

                                <StackLayout Grid.Column="0" Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Label Text="{Binding Quantity}" FontSize="16" FontAttributes="Bold" TextColor="#34C759" />
                                    <Label Text=" in stock" FontSize="14" Opacity="0.7" />
                                    <Label Text=" | " Opacity="0.5" />
                                    <Label Text="{Binding Location}" FontSize="14" Opacity="0.7" />
                                </StackLayout>

                                <ImageButton Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                             Source="delete_icon.png" WidthRequest="24" HeightRequest="24"
                                             Command="{Binding Path=BindingContext.DeleteItemCommand, Source={x:Reference Name=CollectionView}}"
                                             CommandParameter="{Binding}"
                                             BackgroundColor="Transparent" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Empty State -->
        <StackLayout Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center"
                     IsVisible="{Binding Items.Count, Converter={StaticResource IsEmptyConverter}}">
            <Image Source="empty_inventory.png" WidthRequest="120" HeightRequest="120" Opacity="0.5" />
            <Label Text="No items found" FontSize="18" HorizontalOptions="Center" Margin="0,15,0,5"
                   Opacity="0.7" TextColor="{AppThemeBinding Light={StaticResource TextColor}, Dark={StaticResource TextColorDark}}" />
            <Label Text="Start scanning barcodes to add items" FontSize="14" HorizontalOptions="Center" Opacity="0.5" />
        </StackLayout>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Color="#007AFF" />
    </Grid>
</ContentPage>
